{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "期权盈亏图",
  "version": "1.0.0",
  "identifier": "com.payoffchart.cn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "期权盈亏图",
        "width": 1360,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Finance",
    "shortDescription": "中文期权策略工作台",
    "longDescription": "桌面版多腿期权策略工作台：盈亏图、盈利概率、净希腊值、期权链与中文策略库。",
    "copyright": "© 2026 期权盈亏图"
  }
}
