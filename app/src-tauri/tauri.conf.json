{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PayoffLab",
  "version": "1.4.1",
  "identifier": "com.payoffchart.cn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PayoffLab",
        "width": 1360,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#f5f3ef"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "中文期权策略工作台",
    "longDescription": "PayoffLab：桌面版多腿期权策略工作台，提供盈亏图、盈利概率、净希腊值、期权链与中文策略库。",
    "copyright": "© 2026 PayoffLab",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNDQ4OTU4RjhDQzkwNDMKUldSRGtNejRXSWxFSzBISnVUNW5seno1QzJubU9VNmlPRHMxVURCZDgzdWJYUVNURDFvQzV0TXgK",
      "endpoints": [
        "https://github.com/yixin8875/payofflab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
